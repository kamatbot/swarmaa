{
  "name": "swarmaa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Swarmaa: scoped shared memory, quota-aware durable tasks and MCP access for Claude Code, Codex, Antigravity, Dot and Grok.",
  "homepage": "https://swarmaa.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/kamatbot/swarmaa.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "swarmaa": "dist/src/wrap/cli.js"
  },
  "scripts": {
    "postinstall": "npm_config_build_from_source=true npm rebuild node-pty",
    "wrap": "node --import tsx src/wrap/cli.ts wrap",
    "init:local": "node --import tsx scripts/init-local.ts",
    "setup": "node --import tsx scripts/setup.ts",
    "usage": "node --import tsx scripts/usage.ts",
    "capture": "node --import tsx scripts/capture.ts",
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "start": "node --env-file=.env dist/src/server.js",
    "migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "admin": "node --env-file=.env --import tsx scripts/admin.ts",
    "distill": "node --env-file=.env --import tsx scripts/distill.ts",
    "bridge": "node --env-file=.env --import tsx src/bridge.ts",
    "proxy": "node --env-file=.env --import tsx src/stdio-proxy.ts",
    "build": "tsc -p tsconfig.json",
    "deploy:local": "node --import tsx scripts/deploy-local.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/*.integration.test.ts",
    "tunnel": "node --import tsx scripts/tunnel.ts",
    "smoke": "node --env-file=.env --import tsx scripts/smoke.ts",
    "smoke:providers": "node --env-file-if-exists=.env --import tsx scripts/smoke-providers.ts",
    "relay:agent": "node --env-file=.env --import tsx src/relay-agent.ts",
    "relay:pair": "node --import tsx scripts/relay-pair.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "ipaddr.js": "2.5.0",
    "node-pty": "1.1.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
