{
  "name": "swarma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scoped collective memory, durable tasks and MCP access for Dot, Grok, Claude, Codex and Antigravity.",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "init:local": "node --import tsx scripts/init-local.ts",
    "setup": "node --import tsx scripts/setup.ts",
    "usage": "node --import tsx scripts/usage.ts",
    "capture": "node --import tsx scripts/capture.ts",
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "start": "node --env-file=.env dist/src/server.js",
    "migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "admin": "node --env-file=.env --import tsx scripts/admin.ts",
    "distill": "node --env-file=.env --import tsx scripts/distill.ts",
    "bridge": "node --env-file=.env --import tsx src/bridge.ts",
    "proxy": "node --env-file=.env --import tsx src/stdio-proxy.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/*.integration.test.ts",
    "tunnel": "node --import tsx scripts/tunnel.ts",
    "smoke": "node --env-file=.env --import tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "ipaddr.js": "2.5.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
