{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swarmaa-relay",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HOST_ROOM",
        "class_name": "HostRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "HostRoom"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "relay.swarmaa.com",
      "custom_domain": true
    }
  ]
}
