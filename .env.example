# Run npm run init:local to generate unique local credentials without overwriting files.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_VALUE
PG_PORT=54329
DATABASE_URL=postgresql://collective:REPLACE_WITH_RANDOM_VALUE@127.0.0.1:54329/collective
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=http://127.0.0.1:8787
ALLOW_INSECURE_LOCALHOST=true
ALLOWED_ORIGINS=http://127.0.0.1:8787
OAUTH_ENABLED=true
# Exact redirect hosts shown by your client; empty means OAuth registration is closed.
OAUTH_REDIRECT_HOSTS=
# Exact public callback hostnames, no wildcards. Empty disables event subscription methods.
EVENT_CALLBACK_HOSTS=
EVENT_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Use separate credentials in each client/worker environment, never a shared admin token.
# COLLECTIVE_TOKEN=cn_...
# COLLECTIVE_WORKER_TOKEN=cn_...
