<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.collective.bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/ABSOLUTE/PATH/collective-network/clients/macos/bridge-keychain-launcher.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/collective-bridge.stdout.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/collective-bridge.stderr.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
