{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swarmaa-site",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public" },
  "routes": [
    { "pattern": "swarmaa.com", "custom_domain": true },
    { "pattern": "www.swarmaa.com", "custom_domain": true }
  ]
}
